<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- BUS-P2-01 (Astra Gate 12, privacy minimization): every permission below is
         justified by a working capability, and nothing else is declared.

         INTERNET backs OpenStreetMap tile loading, OSRM route requests, and the
         Gemini Live WebSocket.

         Deliberately removed (no matching native capability consumes them — the
         dependency tree has no geolocator/permission_handler plugin, and location
         is fixture-based):
           - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION

         Re-add a permission only together with a just-in-time runtime request, a
         contextual purpose rationale shown before the system prompt, and an
         accessible denial fallback (see docs/audit BUS-P2-01, docs/adr/ADR-004). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- BUS-P2-01 update (ADR-004, native full-duplex voice): RECORD_AUDIO is now
         backed by a real capability — android.media.AudioRecord in
         BusBuddyVoiceChannel streams 16 kHz mono PCM to the Gemini Live WebSocket.
         It is requested just-in-time (only when the passenger taps the mic orb),
         preceded by an announced contextual rationale, and denial keeps the
         text-only journey and device-TTS output working.
         MODIFY_AUDIO_SETTINGS (normal level) lets playback use the
         voice-communication route so hardware echo cancellation suppresses
         self-listen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="BusBuddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
